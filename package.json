{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,yml,yaml}\"",
    "test": "bun test tests/unit",
    "test:integration": "SQS_QUEUE_PREFIX=wager-test bun test --timeout 120000 tests/integration",
    "test:all": "bun run typecheck && bun test tests/unit && bun run test:integration",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "queues:init": "bun scripts/init-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.922.0",
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "@types/express": "5.0.5",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.2",
    "typescript": "5.9.3"
  }
}
